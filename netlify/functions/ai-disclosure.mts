// "AI generated" marking for every downloadable report, per Article 50 of the
// EU Artificial Intelligence Act (Regulation (EU) 2024/1689): outputs of an AI
// system that generates text must be marked as artificially generated, both
// visibly to the reader and in a machine-readable form (file metadata).
import type ExcelJS from 'exceljs'

export type DisclosureLanguage = 'en' | 'el'

export const AI_MARK = {
  en: 'AI generated',
  el: 'Δημιουργήθηκε με AI',
}

export const AI_ACT_REFERENCE = {
  en: 'EU AI Act — Regulation (EU) 2024/1689, Art. 50',
  el: 'Κανονισμός (ΕΕ) 2024/1689 (AI Act), άρθρο 50',
}

/** Single-line visible mark, e.g. "AI generated · EU AI Act — Regulation (EU) 2024/1689, Art. 50". */
export function aiMarkLine(lang: DisclosureLanguage = 'en') {
  return `${AI_MARK[lang]} · ${AI_ACT_REFERENCE[lang]}`
}

/** Machine-readable statement written into document metadata (PDF info, Office core properties). */
export const AI_METADATA_DESCRIPTION =
  'AI-generated content. This document was generated by an artificial intelligence system (Business Reform AI CFO) and is marked as such in accordance with Article 50 of Regulation (EU) 2024/1689 (EU AI Act).'
export const AI_METADATA_KEYWORDS = 'AI generated; AI-generated content; EU AI Act; Regulation (EU) 2024/1689; Article 50'

// Excel header/footer codes: &L = left section, &8 = 8pt font. "&" in the text
// itself must be escaped as "&&".
function excelFooter(lang: DisclosureLanguage) {
  return `&L&8${aiMarkLine(lang).replace(/&/g, '&&')}&R&8&P / &N`
}

/**
 * Marks a finished workbook: the print footer of every sheet carries the mark
 * bottom-left (so it appears on every printed/PDF-exported page), and the
 * workbook properties carry the machine-readable statement. Call after all
 * sheets have been added.
 */
export function applyAiMarkToWorkbook(workbook: ExcelJS.Workbook, lang: DisclosureLanguage = 'en') {
  workbook.subject = AI_MARK.en
  workbook.description = AI_METADATA_DESCRIPTION
  workbook.keywords = AI_METADATA_KEYWORDS
  workbook.category = 'AI-generated report'
  const footer = excelFooter(lang)
  for (const sheet of workbook.worksheets) {
    sheet.headerFooter = { ...sheet.headerFooter, oddFooter: footer, evenFooter: footer, firstFooter: footer }
  }
}
